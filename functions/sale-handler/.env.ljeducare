# Non-secret config for the `ljeducare` project. Firebase loads .env.<project-id> at
# deploy time. Committed on purpose: plain `.env` is gitignored, so config kept there
# would live only on one machine and silently fall back to the defaults below.
#
# PUBLIC_SITE_URL is load-bearing for PayPal: return_url/cancel_url are built from it
# (lib/paypal/orders.js). Unset, it defaults to http://localhost:3000 — which sends real
# payers to a dead page on their own machine and never reaches the capture step.
PUBLIC_SITE_URL=https://ljeducare.com
PUBLIC_SITE_NAME=LJ Educare
