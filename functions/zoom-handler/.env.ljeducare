# Non-secret config for the `ljeducare` project (see sale-handler/.env.ljeducare).
#
# PUBLIC_SITE_URL is where a teacher is sent back to after connecting Zoom
# (lib/oauth.js -> /teacher/profile). Unset, it fell back to the .hosted.app domain —
# a different origin, so the teacher landed there without their session cookie and
# appeared logged out. This is NOT the OAuth redirect URI; that is ZOOM_REDIRECT_URI,
# which points at the deployed zoomCallback function and must stay as registered in
# the Zoom app.
PUBLIC_SITE_URL=https://ljeducare.com
PUBLIC_SITE_NAME=LJ Educare
