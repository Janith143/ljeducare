# Non-secret config for the `ljeducare` project (see sale-handler/.env.ljeducare).
# SITE_NAME prefixes every SMS and email ("LJ Educare: ..."). The code already defaults
# to this value; setting it explicitly keeps the three codebases consistent rather than
# relying on a default that could drift.
PUBLIC_SITE_URL=https://ljeducare.com
PUBLIC_SITE_NAME=LJ Educare

# ── Outgoing email (institute mail server) ──
# Verified 2026-07-18 via transporter.verify(). The apex ljeducare.com:465 times out;
# mail is on mail.ljeducare.com. Its cert is *.web-hosting.com (shared hosting), so
# hostname verification is off (channel is still TLS-encrypted). The login + password
# are secrets (SMTP_EMAIL_USER, SMTP_EMAIL_PASS); only non-secret config lives here.
SMTP_HOST=mail.ljeducare.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=info@ljeducare.com
