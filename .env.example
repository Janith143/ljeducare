# ── Firebase client config (from Firebase console → Project settings → Web app) ──
NEXT_PUBLIC_FIREBASE_API_KEY=CHANGE_ME
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ljeducare-CHANGE_ME.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ljeducare-CHANGE_ME
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ljeducare-CHANGE_ME.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=CHANGE_ME
NEXT_PUBLIC_FIREBASE_APP_ID=CHANGE_ME

# ── Site ──
NEXT_PUBLIC_SITE_NAME=LJ Educare
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=LKR

# ── Auth session cookies (next-firebase-auth-edge) ──
# Generate two random 32+ char strings (e.g. `openssl rand -base64 32`)
AUTH_COOKIE_SIGNATURE_KEY_CURRENT=CHANGE_ME_RANDOM_32_CHARS
AUTH_COOKIE_SIGNATURE_KEY_PREVIOUS=CHANGE_ME_RANDOM_32_CHARS_2

# ── Server-side Firebase Admin (local dev only; App Hosting uses ADC) ──
# Path to a service-account JSON, OR leave unset to use emulators/ADC
GOOGLE_APPLICATION_CREDENTIALS=

# ── Emulators (set to any value to point the app at local emulators) ──
NEXT_PUBLIC_USE_EMULATORS=1
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# ── On-demand ISR revalidation (shared with database-triggers function) ──
REVALIDATE_SECRET=CHANGE_ME_RANDOM

# ── Payment gateways (server/functions only; also mirrored in settings/gateways doc) ──
PAYPAL_CLIENT_ID=CHANGE_ME
PAYPAL_CLIENT_SECRET=CHANGE_ME
PAYPAL_ENV=sandbox
MARX_API_KEY=CHANGE_ME

# ── Guardian alerts ──
NOTIFYLK_USER_ID=CHANGE_ME
NOTIFYLK_API_KEY=CHANGE_ME
NOTIFYLK_SENDER_ID=CHANGE_ME
SMTP_EMAIL_USER=CHANGE_ME
SMTP_EMAIL_PASS=CHANGE_ME

# Required in emulator mode for server-side token verification
GCLOUD_PROJECT=demo-ljeducare
