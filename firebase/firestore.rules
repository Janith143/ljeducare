rules_version = '2';

// LJ Educare — (default) database rules.
// Authorization derives from SERVER-SET custom claims (auth-security function):
//   role: main_admin | manager | teacher_admin | teacher | student | kiosk
//   perms: delegated admin permission keys (manager / teacher_admin)
// Financial collections are Admin-SDK-only (Cloud Functions bypass rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() { return request.auth != null; }
    function role() { return isAuthed() ? request.auth.token.get('role', '') : ''; }
    function isMainAdmin() { return role() == 'main_admin'; }
    function isAdminArea() { return role() in ['main_admin', 'manager', 'teacher_admin']; }
    function isStaffRole() { return role() in ['main_admin', 'manager', 'teacher_admin', 'teacher']; }
    function hasPerm(p) {
      return isMainAdmin()
        || (isAdminArea() && p in request.auth.token.get('perms', []));
    }
    function isSelf(uid) { return isAuthed() && request.auth.uid == uid; }

    // users/{uid} — profile docs. Role/permissions/enrollments are server-managed.
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdminArea();
      allow create: if isSelf(uid)
        && request.resource.data.role == 'student'
        && !('permissions' in request.resource.data)
        && !('enrolledClassIds' in request.resource.data)
        && !('enrolledCourseIds' in request.resource.data)
        && !('enrolledQuizIds' in request.resource.data);
      allow update: if (isSelf(uid) || hasPerm('users'))
        && request.resource.data.role == resource.data.role
        && request.resource.data.get('permissions', []) == resource.data.get('permissions', [])
        && request.resource.data.get('enrolledClassIds', []) == resource.data.get('enrolledClassIds', [])
        && request.resource.data.get('enrolledCourseIds', []) == resource.data.get('enrolledCourseIds', [])
        && request.resource.data.get('enrolledQuizIds', []) == resource.data.get('enrolledQuizIds', []);
      allow delete: if isMainAdmin();
    }

    // staff/{id} — teacher profiles. Money fields (commissionRate, manualBalance,
    // totalEarned, lastReset) are staff-admin/server managed.
    match /staff/{id} {
      allow read: if true; // public bio pages
      allow create, delete: if hasPerm('staff');
      allow update: if hasPerm('staff')
        || (isStaffRole()
            && resource.data.userId == request.auth.uid
            && request.resource.data.commissionRate == resource.data.commissionRate
            && request.resource.data.get('manualBalance', 0) == resource.data.get('manualBalance', 0)
            && request.resource.data.get('totalEarned', 0) == resource.data.get('totalEarned', 0));

      // Zoom tokens/secrets — server-only (Admin SDK). Never client-readable.
      match /private/{doc} { allow read, write: if false; }
    }

    // Zoom session tracking + OAuth state — server-only (Admin SDK).
    match /zoom_sessions/{id} { allow read, write: if false; }
    match /zoom_oauth_state/{id} { allow read, write: if false; }

    // Content — publicly readable when published; writes for owning teacher or admins.
    match /classes/{id} {
      allow read: if resource.data.isPublished == true || isStaffRole() || role() == 'kiosk';
      allow create, update: if isStaffRole();
      allow delete: if hasPerm('classes');
    }
    match /courses/{id} {
      allow read: if resource.data.isPublished == true || isStaffRole();
      allow create, update: if isStaffRole();
      allow delete: if hasPerm('courses');
    }
    match /quizzes/{id} {
      allow read: if resource.data.isPublished == true || isStaffRole();
      allow create, update: if isStaffRole();
      allow delete: if hasPerm('content');
    }

    // Browse categories — publicly readable when enabled; content admins manage them.
    match /categories/{id} {
      allow read: if resource.data.enabled == true || isStaffRole();
      allow create, update, delete: if hasPerm('content');
    }

    // Financial + credential collections — server-only (Admin SDK).
    match /sales/{id} { allow read, write: if false; }
    // Cart orders — server-only (Admin SDK); finalize splits into per-item sales.
    match /orders/{id} { allow read, write: if false; }
    match /financial_ledger/{id} { allow read, write: if false; }
    match /teacher_payments/{id} { allow read, write: if false; }
    // Certificates: public verification + the student's own list are served by the
    // server (Admin SDK), so client reads are scoped to the owner / admins only.
    match /certificates/{id} {
      allow read: if isAdminArea()
        || (isAuthed() && resource.data.studentId == request.auth.uid);
      allow write: if false;
    }
    match /submissions/{id} {
      allow read: if isStaffRole() || (isAuthed() && resource.data.studentId == request.auth.uid);
      allow write: if false; // written by functions
    }
    match /kiosk_devices/{id} { allow read: if hasPerm('settings'); allow write: if false; }
    match /loginEvents/{id} { allow read: if isMainAdmin(); allow write: if false; }
    // Cross-app connector: link tokens + rate-limit counters — server-only (Admin SDK).
    match /accountLinks/{id} { allow read, write: if false; }
    match /connector_rate_limits/{id} { allow read, write: if false; }
    // Marketplace delivery entitlements (pseudonymous partner-hub purchases) — server-only
    // (Admin SDK via connector /enroll + /content).
    match /externalEntitlements/{id} { allow read, write: if false; }
    // Landing page contact form + newsletter. Submissions are written by the public
    // server action (Admin SDK) after honeypot/rate-limit checks, never by the client,
    // so writes stay closed and reads need the landing_page permission.
    match /landing_inquiries/{id} {
      allow read: if hasPerm('landing_page');
      allow write: if false;
    }
    match /newsletter_subscribers/{id} {
      allow read: if hasPerm('landing_page');
      allow write: if false;
    }
    match /landing_rate_limits/{id} { allow read, write: if false; }
    // Notification plumbing — all server-only (Admin SDK). The outbox can hold
    // guardian/student phone numbers, so it is not client-readable.
    match /notifications_outbox/{id} { allow read, write: if false; }
    // Idempotency claims for class reminders. Client writes would let a caller
    // suppress a reminder (or force a duplicate) by forging a doc id.
    match /class_reminder_log/{id} { allow read, write: if false; }
    // Device sessions — a user may read their own to detect being kicked; writes server-only.
    match /userSessions/{id} {
      allow read: if isAuthed() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /activity_logs/{id} {
      allow read: if hasPerm('activity_logs');
      allow create: if isAuthed();
      allow update, delete: if false;
    }

    // Requests students create; server/admin advance the status.
    match /customClassRequests/{id} {
      allow read: if isAdminArea() || isStaffRole()
        || (isAuthed() && resource.data.studentId == request.auth.uid);
      allow create: if isAuthed() && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    // Per-recipient notifications: read your own; mark-as-read is the only client write.
    match /notifications/{id} {
      allow read: if isAdminArea()
        || (isAuthed() && resource.data.recipientId == request.auth.uid);
      allow update: if isAuthed()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false; // server-only (Admin SDK)
    }

    // settings/* — currencies & site config readable; writes main_admin only
    // (gateway secrets live in function secrets, not here).
    match /settings/{doc} {
      // `connector` holds the clazz.lk marketplace pairing KEY — never client readable or
      // writable (the settings server action writes it via the Admin SDK). The exclusion must
      // live in THIS rule: Firestore ORs every matching rule, so adding a separate stricter
      // match for /settings/connector would NOT revoke the access granted here.
      allow read: if doc != 'connector';
      allow write: if isMainAdmin() && doc != 'connector';
    }
  }
}
