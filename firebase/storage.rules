rules_version = '2';

// LJ Educare storage rules.
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthed() { return request.auth != null; }
    function role() { return isAuthed() ? request.auth.token.get('role', '') : ''; }
    function isStaffRole() { return role() in ['main_admin', 'manager', 'teacher_admin', 'teacher']; }
    function isAdminArea() { return role() in ['main_admin', 'manager', 'teacher_admin']; }
    function isImageUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    // Payment slips accept image or PDF — a separate helper so this doesn't loosen
    // isImageUnder5MB()'s other callers (profile/category/landing/cover images).
    function isSlipFileUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }

    match /site-assets/{file=**} {
      allow read: if true;
      allow write: if role() == 'main_admin';
    }
    match /category-images/{file=**} {
      allow read: if true;
      allow write: if isAdminArea() && isImageUnder5MB();
    }
    // Landing page media. Uploads run through the Admin SDK (server action gated on
    // the landing_page permission), so this is a backstop rather than the main gate.
    match /landing-images/{file=**} {
      allow read: if true;
      allow write: if isAdminArea() && isImageUnder5MB();
    }
    match /cover-images/{file=**} {
      allow read: if true;
      allow write: if isStaffRole() && isImageUnder5MB();
    }
    match /profile-images/{file=**} {
      allow read: if true;
      allow write: if isAuthed() && isImageUnder5MB();
    }
    match /payment-slips/{file=**} {
      allow read: if isAdminArea();
      allow write: if isAuthed() && isSlipFileUnder5MB();
    }
    match /certificates/{file=**} {
      allow read: if true; // public verification downloads
      allow write: if false; // server-only
    }
  }
}
